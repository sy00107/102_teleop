# cp config.local.env.example config.local.env
# 실제 장치를 확인해서 수정한다. 보정 파일은 각 팔에서 따로 만든다.
export FOLLOWER_PORT="/dev/ttyACM0"
export LEADER_PORT="/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0"

# 기본값은 원본 코드와 동일: roll +45°, pitch 0°, gravity scale 1.0.
# export CONDA_ENV="yoidle"
# export CAMERAS='{"wrist":{"type":"intelrealsense","serial_number_or_name":"YOUR_SERIAL","width":640,"height":480,"fps":30}}'
# export ALLOW_STATE_ONLY_RECORDING="1"  # 관절 정보만 기록하는 시험

# 원본 설정은 리더 통신 상실 시 home 복귀다. 복귀 경로를 확인하지 않았다면
# 이 PC에서 현재 자세 유지 동작을 선택할 수 있다.
# export COMM_LOSS_ACTION="hold"
