index 00000000..29f6e94b
--- /dev/null
+++ b/src/lerobot/robots/rebot_b601_follower/diagnostics.py
@@ -0,0 +1,293 @@
+# Copyright 2026 The HuggingFace Inc. team. All rights reserved.
+# Licensed under the Apache License, Version 2.0 (the "License").
+"""Bounded, best-effort diagnostics. Only the writer thread touches the filesystem.
+
+A successful transport call is NOT a motor acknowledgement. MotorBridge 0.5.6
+has no per-sample RX timestamp/sequence; callers must record those as unknown.
+"""
+
+from __future__ import annotations
+
+import csv
+import hashlib
+import json
+import logging
+import math
+import os
+import platform
+import queue
+import threading
+import time
+import uuid
+from collections import deque
+from contextlib import suppress
+from pathlib import Path
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+
+def _json_safe(value: Any) -> Any:
+    if isinstance(value, float) and not math.isfinite(value):
+        return {"nonfinite": str(value)}
+    if isinstance(value, dict):
+        return {str(k): _json_safe(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_json_safe(v) for v in value]
+    if value is None or isinstance(value, (str, int, float, bool)):
+        return value
+    return str(value)
+
+
+def _line(value: Any) -> str:
+    return json.dumps(_json_safe(value), ensure_ascii=False, allow_nan=False, separators=(",", ":")) + "\n"
+
+
+class DiagnosticsRecorder:
+    """Memory and queue sizes are finite; overflow loses diagnostics, never blocks motion.
+
+    emit payloads must be caller-owned snapshots, not mutable motor-state objects.
+    Pre/post windows can be shorter if the record limit is reached, the process
+    exits, or storage fails. Manifests expose loss and incomplete windows.
+    """
+
+    def __init__(
+        self,
+        folder: str | Path,
+        *,
+        metadata: dict[str, Any] | None = None,
+        pre_seconds: float = 10.0,
+        post_seconds: float = 5.0,
+        buffer_records: int = 8192,
+        queue_records: int = 4096,
+        rotation_bytes: int = 32 * 1024 * 1024,
+        keep_files: int = 4,
+    ):
+        self.folder = Path(folder).expanduser()
+        self.pre_seconds, self.post_seconds = pre_seconds, post_seconds
+        self._history: deque = deque(maxlen=buffer_records)
+        self._queue: queue.Queue = queue.Queue(maxsize=queue_records)
+        self._incidents: list[dict] = []
+        self._lock = threading.Lock()
+        self._stop = threading.Event()
+        self._seq = 0
+        self.rotation_bytes, self.keep_files = rotation_bytes, keep_files
+        self.metadata = metadata or {}
+        self.dropped_records = 0
+        self.buffer_evictions = 0
+        self.dropped_incidents = 0
+        self.closed = False
+        self.error: str | None = None
+        self._thread = threading.Thread(target=self._run, name="b601-diagnostics", daemon=True)
+        self._thread.start()
+
+    def emit(self, kind: str, payload: dict[str, Any]) -> None:
+        # No formatting, console output, filesystem access, or blocking queue put.
+        try:
+            with self._lock:
+                self._emit_locked(kind, payload)
+        except Exception:
+            self.dropped_records += 1
+
+    def _emit_locked(self, kind: str, payload: dict[str, Any]) -> dict:
+        now = time.monotonic_ns()
+        self._seq += 1
+        record = {
+            "seq": self._seq,
+            "mono_ns": now,
+            "wall_ns": time.time_ns(),
+            "kind": kind,
+            "thread": threading.current_thread().name,
+            "data": payload,
+        }
+        cutoff = now - int(self.pre_seconds * 1e9)
+        while self._history and self._history[0]["mono_ns"] < cutoff:
+            self._history.popleft()
+        if len(self._history) == self._history.maxlen:
+            self.buffer_evictions += 1
+        self._history.append(record)
+        for incident in self._incidents:
+            if now <= incident["deadline_ns"]:
+                if len(incident["post"]) == incident["post"].maxlen:
+                    incident["post_evictions"] += 1
+                incident["post"].append(record)
+        try:
+            self._queue.put_nowait(record)
+        except queue.Full:
+            self.dropped_records += 1
+        return record
+
+    def trigger(self, code: str, payload: dict[str, Any]) -> None:
+        try:
+            with self._lock:
+                incident_id = uuid.uuid4().hex[:12]
+                record = self._emit_locked("fault", {"code": code, "incident_id": incident_id, **payload})
+                if len(self._incidents) >= 8:
+                    self.dropped_incidents += 1
+                    return
+                self._incidents.append(
+                    {
+                        "id": incident_id,
+                        "code": code,
+                        "trigger_ns": record["mono_ns"],
+                        "deadline_ns": record["mono_ns"] + int(self.post_seconds * 1e9),
+                        "pre": list(self._history),
+                        "post": deque(maxlen=self._history.maxlen),
+                        "post_evictions": 0,
+                        "pre_written": False,
+                        "buffer_evictions_at_trigger": self.buffer_evictions,
+                    }
+                )
+        except Exception:
+            self.dropped_incidents += 1
+
+    def status(self) -> dict[str, Any]:
+        with self._lock:
+            return {
+                "dropped_trace_records": self.dropped_records,
+                "buffer_evictions": self.buffer_evictions,
+                "dropped_incidents": self.dropped_incidents,
+                "pending_incidents": len(self._incidents),
+                "writer_error": self.error,
+                "writer_alive": self._thread.is_alive(),
+                "queue_capacity": self._queue.maxsize,
+                "buffer_capacity": self._history.maxlen,
+            }
+
+    def close(self, timeout: float = 2.0) -> None:
+        self._stop.set()
+        self._thread.join(timeout=timeout)
+        self.closed = not self._thread.is_alive()
+        if not self.closed:
+            logger.warning(
+                "Diagnostics writer did not finish; logs may be incomplete. Motor cleanup continues."
+            )
+
+    def _ready_incidents(self) -> list[dict]:
+        now = time.monotonic_ns()
+        with self._lock:
+            ready = [i for i in self._incidents if self._stop.is_set() or now >= i["deadline_ns"]]
+            self._incidents = [i for i in self._incidents if i not in ready]
+        return ready
+
+    def _write_incident(self, incident: dict, *, partial: bool = False) -> None:
+        records = incident["pre"] + list(incident["post"])
+        info = {k: v for k, v in incident.items() if k not in ("pre", "post")}
+        info.update(
+            {
+                "kind": "incident_manifest",
+                "requested_pre_s": self.pre_seconds,
+                "requested_post_s": self.post_seconds,
+                "post_window_complete": not partial and time.monotonic_ns() >= incident["deadline_ns"],
+                "available_pre_s": (incident["trigger_ns"] - records[0]["mono_ns"]) / 1e9,
+                "last_record_ns": records[-1]["mono_ns"],
+                **self.status(),
+            }
+        )
+        suffix = ".partial" if partial else ""
+        target = self.folder / "incidents" / f"incident_{incident['id']}{suffix}.jsonl"
+        temporary = target.with_suffix(".tmp")
+        with temporary.open("w", encoding="utf-8") as stream:
+            stream.write(_line(info))
+            for record in records:
+                stream.write(_line(record))
+        temporary.replace(target)
+        if not partial:
+            partial_path = target.with_name(f"incident_{incident['id']}.partial.jsonl")
+            if partial_path.exists():
+                partial_path.unlink()
+
+    def _write_pending_pre(self) -> None:
+        with self._lock:
+            pending = [{**i, "post": []} for i in self._incidents if not i["pre_written"]]
+            for i in self._incidents:
+                i["pre_written"] = True
+        for incident in pending:
+            self._write_incident(incident, partial=True)
+
+    def _write_manifest(self, *, finished: bool) -> None:
+        manifest = {
+            "schema": 1,
+            "finished": finished,
+            "python": platform.python_version(),
+            "pid": os.getpid(),
+            "metadata": self.metadata,
+            **self.status(),
+            "motor_rx_timestamp_available": False,
+            "transport_success_is_execution_ack": False,
+            "trace_retention": {"rotation_bytes": self.rotation_bytes, "keep_files": self.keep_files},
+        }
+        temporary = self.folder / "manifest.tmp"
+        temporary.write_text(_line(manifest), encoding="utf-8")
+        temporary.replace(self.folder / "manifest.json")
+
+    def _run(self) -> None:
+        trace = events = telemetry = None
+        try:
+            self.folder.mkdir(parents=True, exist_ok=True)
+            (self.folder / "incidents").mkdir(exist_ok=True)
+            source_hashes = {}
+            for filename in self.metadata.get("source_files", []):
+                source_hashes[filename] = hashlib.sha256(Path(filename).read_bytes()).hexdigest()
+            self.metadata["source_sha256"] = source_hashes
+            self._write_manifest(finished=False)
+            events = (self.folder / "events.jsonl").open("a", encoding="utf-8", buffering=1)
+            telemetry = (self.folder / time.strftime("b601_%Y%m%d_%H%M%S.csv")).open(
+                "w", encoding="utf-8", newline="", buffering=1
+            )
+            csv_writer = csv.writer(telemetry)
+            csv_header = False
+            trace_index, trace_bytes = 0, 0
+            trace = (self.folder / "trace_000000.jsonl").open("w", encoding="utf-8", buffering=1)
+            last_status = time.monotonic()
+            while not self._stop.is_set() or not self._queue.empty():
+                try:
+                    record = self._queue.get(timeout=0.02)
+                except queue.Empty:
+                    record = None
+                if record is not None:
+                    line = _line(record)
+                    size = len(line.encode("utf-8"))
+                    if trace_bytes and trace_bytes + size > self.rotation_bytes:
+                        trace.close()
+                        trace_index += 1
+                        trace = (self.folder / f"trace_{trace_index:06d}.jsonl").open(
+                            "w", encoding="utf-8", buffering=1
+                        )
+                        trace_bytes = 0
+                        expired = self.folder / f"trace_{trace_index - self.keep_files:06d}.jsonl"
+                        if expired.exists():
+                            expired.unlink()
+                    trace.write(line)
+                    trace_bytes += size
+                    if record["kind"] in ("fault", "state", "session", "parameter_probe_error"):
+                        events.write(line)
+                    if record["kind"] == "telemetry":
+                        if not csv_header:
+                            csv_writer.writerow(record["data"]["columns"])
+                            csv_header = True
+                        csv_writer.writerow(record["data"]["row"])
+                self._write_pending_pre()
+                for incident in self._ready_incidents():
+                    self._write_incident(incident)
+                if time.monotonic() - last_status >= 1.0:
+                    marker = self.folder / "mark_incident"
+                    if marker.exists():
+                        note = marker.read_text(encoding="utf-8")[:1000]
+                        marker.unlink()
+                        self.trigger("manual_marker", {"note": note})
+                    self._write_manifest(finished=False)
+                    last_status = time.monotonic()
+            for incident in self._ready_incidents():
+                self._write_incident(incident)
+            self._write_manifest(finished=True)
+        except Exception as error:
+            self.error = f"{type(error).__name__}: {error}"
+            logger.error(
+                "DIAGNOSTICS STORAGE FAILED; motor policy unchanged; evidence may be lost: %s", self.error
+            )
+        finally:
+            for stream in (trace, events, telemetry):
+                if stream is not None:
+                    with suppress(Exception):
+                        stream.close()
