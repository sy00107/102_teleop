@@ -0,0 +1,19 @@
+"""Freeze B601 model/controller identity next to each recorded dataset."""
+
+import json
+from pathlib import Path
+
+
+def write_control_metadata(robot, dataset_root):
+    metadata = json.loads(json.dumps(robot.control_metadata(), allow_nan=False))
+    folder = Path(dataset_root) / "meta"
+    folder.mkdir(parents=True, exist_ok=True)
+    path = folder / "b601_control.json"
+    if path.exists() and json.loads(path.read_text()) != metadata:
+        raise ValueError("B601 controller/model differs from this dataset. Use a new dataset name.")
+    if not path.exists():
+        temp = path.with_suffix(".tmp")
+        temp.write_text(json.dumps(metadata, indent=2, allow_nan=False))
+        temp.replace(path)
+    if metadata["gravity_urdf"]:
+        (folder / "b601_gravity_model.urdf").write_bytes(Path(metadata["gravity_urdf"]).read_bytes())
