# 모든 스크립트가 source 하는 설정. 리더암 연결 후 포트만 채우면 된다.
# 포트는 ./scripts/01_find_ports.sh 로 확인.

# 팔로워: B601-DM은 Damiao 시리얼 브릿지(/dev/ttyACM*), RS는 CAN(can0)
export FOLLOWER_FAMILY="dm"            # dm | rs
export FOLLOWER_PORT="/dev/ttyACM0"    # TODO: 실제 포트 확인
export FOLLOWER_ID="follower"

# 리더(Star Arm 102): FashionStar UART 서보, USB-시리얼
export LEADER_PORT="/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0"
export LEADER_ID="leader"

# 팔로워 중력 토크 feed-forward (MIT tau_ff). 마운트가 URDF 기준 roll +45도로 기울어 있다.
# 시뮬레이션과 같은 카메라 포함 모델/스케일. 실물 첫 시험은 팔을 받친 상태에서 한다.
# 장착 부호는 URDF 기준 +45도이며 실물 축·모터 영점 일치 여부는 실기 확인 대상이다.
export GRAVITY_COMP="1"
export GRAVITY_URDF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/assets/B601_DM_wrist_d435i_no_plate.urdf"
export GRAVITY_MOUNT_ROLL_DEG="45.0"
export GRAVITY_MOUNT_PITCH_DEG="0.0"
export GRAVITY_TAU_SCALE="1.0"
export GRAVITY_FINGER_MASS_KG="0.03"  # 시뮬레이션과 같은 임시 손가락 질량
export MOTOR_CONTROL_HZ="100"
export COMMAND_TIMEOUT_S="0.25"
export MAX_TARGET_VELOCITY_DEG_S="30"
export MAX_TARGET_ACCELERATION_DEG_S2="120"
# 리더 통신이 끊기면: home = set-zero 자세로 천천히 복귀, hold = 현재 자세 유지
# 주의: home 은 충돌 검사 없이 관절공간 직선 경로로 이동한다. 책상/베이스 간섭 확인 필수.
# 그리퍼 전용 속도 제한 (팔과 별개). 파지/놓기를 빠르게 하려면 올린다. 기본 300/3000
export GRIPPER_MAX_VELOCITY_DEG_S="900"
export GRIPPER_MAX_ACCELERATION_DEG_S2="20000"
# 그리퍼 완전 개방 시 모터 각도(deg). 실측: 손으로 끝까지 벌렸을 때 -341.02도 (2026-11-13).
# 끝단에 계속 밀지 않도록 6도 여유를 둔 335. (참고: LeRobot 기본 270, ROS 공식 286.48)
export GRIPPER_OPEN_DEG="335"
export COMM_LOSS_ACTION="home"
export COMM_LOSS_HOME_DELAY_S="0.5"
export HOME_VELOCITY_DEG_S="20"
export HOME_ACCELERATION_DEG_S2="60"

# 카메라: 비어 있으면 모터만 사용(처음 시험은 비워 두는 걸 권장)
# 예: CAMERAS='{"wrist": {"type": "intelrealsense", "serial_number_or_name": "XXXXXXXX", "width": 640, "height": 480, "fps": 30}}'
export CAMERAS=""
# 영상 없는 모터 점검 기록만 의도할 때 1. 본 수집에는 CAMERAS를 먼저 설정한다.
export ALLOW_STATE_ONLY_RECORDING="0"

# 데이터 수집
export DATASET_NAME="produce_demo_v1"  # ~/yoidle/datasets/<이름> 에 저장 (Hub 업로드 안 함)
export TASK="Pick up the object and put it in the basket"
export FPS=30
export NUM_EPISODES=10
export EPISODE_TIME_S=30
export RESET_TIME_S=10

# 안전: 명령 한 번에 허용할 최대 관절 변화(도). 처음엔 작게.
# 설정값이 작으면 큰 관절(kd/kp≈0.27s)은 30도/s 추종 지연(≈8도)보다 작아 속도가 제한된다
export MAX_RELATIVE_TARGET=15.0

# 경로
export YOIDLE_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LEROBOT_DIR="$YOIDLE_HOME/lerobot"
export CONDA_ENV="yoidle"

# PC별 포트·카메라·환경 이름은 이 파일에 재정의한다(Git 제외).
if [[ -f "$YOIDLE_HOME/config.local.env" ]]; then
  source "$YOIDLE_HOME/config.local.env"
fi
